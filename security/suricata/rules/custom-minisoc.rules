# --- Port Scanning Detection ---
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"MINISOC - TCP Port Scan Detected"; flags:S; threshold: type threshold, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000001; rev:2; metadata:mitre_technique_id T1046, mitre_tactic_name Discovery;)

# --- SSH Brute Force ---
alert tcp $EXTERNAL_NET any -> $HOME_NET $SSH_PORTS (msg:"MINISOC - SSH Brute Force Attempt"; flow:to_server,established; threshold: type threshold, track by_src, count 5, seconds 60; classtype:attempted-admin; sid:1000002; rev:2; metadata:mitre_technique_id T1110, mitre_tactic_name Credential_Access;)

# --- DNS Tunneling (long queries) ---
alert dns $HOME_NET any -> any any (msg:"MINISOC - Possible DNS Tunneling (long query)"; dns.query; pcre:"/^.{50,}/"; classtype:bad-unknown; sid:1000010; rev:2; metadata:mitre_technique_id T1071.004, mitre_tactic_name Command_and_Control;)

# --- Known C2 Domains ---
alert dns $HOME_NET any -> any any (msg:"MINISOC - Known C2 Domain Resolution"; dns.query; content:"evil.com"; nocase; classtype:trojan-activity; sid:1000020; rev:2; metadata:mitre_technique_id T1071.001;)
alert dns $HOME_NET any -> any any (msg:"MINISOC - Cobalt Strike Default Domain"; dns.query; content:".stage."; nocase; classtype:trojan-activity; sid:1000021; rev:2;)

# --- Data Exfiltration (large outbound) ---
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"MINISOC - Large Outbound TCP Segment"; flow:to_server,established; dsize:>60000; threshold: type threshold, track by_src, count 10, seconds 60; classtype:bad-unknown; sid:1000030; rev:3; metadata:mitre_technique_id T1048;)

# --- Crypto Mining ---
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"MINISOC - TLS to Known Mining Pool"; tls.sni; content:"pool."; nocase; classtype:policy-violation; sid:1000040; rev:2; metadata:mitre_technique_id T1496;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 3333 (msg:"MINISOC - Connection to Stratum Mining Port"; flow:to_server,established; content:"mining.subscribe"; classtype:policy-violation; sid:1000041; rev:2;)

# --- Web Attacks ---
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"MINISOC - SQL Injection Attempt"; flow:to_server,established; http.uri; pcre:"/(\%27|\'|\-\-|\%23|#)/i"; classtype:web-application-attack; sid:1000050; rev:2; metadata:mitre_technique_id T1190;)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"MINISOC - XSS Attempt"; flow:to_server,established; http.uri; content:"<script"; nocase; classtype:web-application-attack; sid:1000051; rev:2;)

# --- Reverse Shell Detection ---
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"MINISOC - Possible Reverse Shell"; flow:established; content:"/bin/sh"; content:"-i"; distance:0; classtype:trojan-activity; sid:1000060; rev:2; metadata:mitre_technique_id T1059.004;)