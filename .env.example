# ========================
# OPENSEARCH
# ========================
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_PROTOCOL=http
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_ADMIN_PASSWORD=MinisocAdmin!2026Secure
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# ========================
# SURICATA
# ========================
# Check with: ip -br link
SURICATA_INTERFACE=enp0s3

# ========================
# VAULT
# ========================
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root_vault_token_minisoc_2026

# ========================
# THREAT INTELLIGENCE (À remplir selon tes clés API)
# ========================
VIRUSTOTAL_API_KEY=YOUR_VIRUSTOTAL_API_KEY
ABUSEIPDB_API_KEY=YOUR_ABUSEIPDB_API_KEY
MISP_URL=https://misp.local
MISP_API_KEY=YOUR_MISP_API_KEY
OTX_API_KEY=YOUR_OTX_API_KEY
SHODAN_API_KEY=YOUR_SHODAN_API_KEY

# ========================
# n8n (SOAR)
# ========================
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=N8nAdminPass2026!#
N8N_WEBHOOK_URL=https://soc.local/n8n/
N8N_ENCRYPTION_KEY=N8nEncKey2026_q8P3vX9k2Lm7nR4j

# ========================
# GRAFANA
# ========================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GrafanaAdminPass2026!#
GRAFANA_ROOT_URL=https://soc.local/grafana

# ========================
# SMTP (Notifications)
# ========================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@minisoc.local
SMTP_PASSWORD=SmtpPassword2026!
SMTP_FROM=noreply@minisoc.local

# ========================
# SLACK (Notifications)
# ========================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ========================
# THEHIVE / CORTEX
# ========================
THEHIVE_URL=http://thehive:9000
THEHIVE_API_KEY=YOUR_THEHIVE_API_KEY
CORTEX_URL=http://cortex:9001
CORTEX_API_KEY=YOUR_CORTEX_API_KEY

# ========================
# BACKUP
# ========================
BACKUP_ENCRYPTION_PASSPHRASE=PassphraseBackup2026SecretKey
BACKUP_S3_BUCKET=s3://minisoc-backups
BACKUP_RETENTION_DAYS=30

# ========================
# SSL/TLS
# ========================
SSL_CERT_PATH=./infrastructure/nginx/ssl/fullchain.pem
SSL_KEY_PATH=./infrastructure/nginx/ssl/privkey.pem