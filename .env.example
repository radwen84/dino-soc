# ========================
# FRONTEND
# ========================
VITE_API_URL=https://soc.local/api
VITE_WS_URL=wss://soc.local/ws

# ========================
# WAZUH
# ========================
WAZUH_HOST=wazuh-manager
WAZUH_API_PORT=55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=WazuhAdminPass2026!#
