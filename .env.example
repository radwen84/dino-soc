# ============================================================
# Mini-SOC Platform - Environment Variables
# ============================================================
# ⚠️  WARNING: Replace ALL values below with your own secrets
#     before deploying. Never commit real credentials to git.
# ============================================================

# ========================
# GENERAL
# ========================
NODE_ENV=production
TZ=UTC
DOMAIN=soc.local
COMPOSE_PROJECT_NAME=minisoc

# ========================
# DATABASE - PostgreSQL
# ========================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=minisoc
POSTGRES_USER=minisoc_app
POSTGRES_PASSWORD=CHANGE_ME_USE_DOCKER_SECRET
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=CHANGE_ME

# Database URL for Prisma
# With docker-compose.yml, DATABASE_URL is built from the Docker db_password secret.

# ========================
# REDIS
# ========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_USE_DOCKER_SECRET

# ========================
# JWT / AUTH
# ========================
JWT_SECRET=CHANGE_ME_USE_DOCKER_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_USE_DOCKER_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# ========================
# API
# ========================
API_PORT=4000
API_PREFIX=api
API_CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://soc.local,https://soc.local,https://localhost

# ========================
# FRONTEND
# ========================
VITE_API_URL=https://soc.local/api
VITE_WS_URL=wss://soc.local/ws

# ========================
# WAZUH
# ========================
WAZUH_HOST=wazuh-manager
WAZUH_API_PORT=55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=CHANGE_ME_USE_DOCKER_SECRET
WAZUH_AGENT_PORT=1514

# ========================
# OPENSEARCH
# ========================
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_PROTOCOL=http
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_ADMIN_PASSWORD=CHANGE_ME_USE_DOCKER_SECRET
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# ========================
# SURICATA
# ========================
# Check with: ip -br link
SURICATA_INTERFACE=enp0s3

# ========================
# VAULT
# ========================
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=CHANGE_ME

# ========================
# THREAT INTELLIGENCE
# ========================
VIRUSTOTAL_API_KEY=CHANGE_ME
ABUSEIPDB_API_KEY=CHANGE_ME

# MISP Local instance (Docker Compose: http://misp:80, K8s: http://misp.soc.svc.cluster.local:80)
MISP_URL=http://misp:80
MISP_API_KEY=YOUR_MISP_API_KEY
MISP_DB_USER=misp
MISP_DB_PASSWORD=CHANGE_ME
MISP_DB_ROOT_PASSWORD=CHANGE_ME

# AlienVault OTX
OTX_API_KEY=CHANGE_ME

# STIX/TAXII 2.1
TAXII_URL=
TAXII_API_ROOT=
TAXII_COLLECTION_ID=
TAXII_USERNAME=
TAXII_PASSWORD=

SHODAN_API_KEY=CHANGE_ME

# ========================
# n8n (SOAR)
# ========================
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME
N8N_WEBHOOK_URL=https://soc.local/n8n/
N8N_ENCRYPTION_KEY=CHANGE_ME

# ========================
# GRAFANA
# ========================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GrafanaAdminPass2026!#
GRAFANA_ROOT_URL=https://soc.local/grafana

# ========================
# SMTP (Notifications)
# ========================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@minisoc.local
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@minisoc.local

# ========================
# SLACK (Notifications)
# ========================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ========================
# THEHIVE / CORTEX
# ========================
# Docker Compose: http://thehive:9000, K8s: http://thehive.soc.svc.cluster.local:9000
THEHIVE_URL=http://thehive:9000
THEHIVE_API_KEY=YOUR_THEHIVE_API_KEY
THEHIVE_ORGANIZATION=Mini-SOC
CORTEX_URL=http://cortex:9001
CORTEX_API_KEY=YOUR_CORTEX_API_KEY

# ========================
# BACKUP
# ========================
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME
BACKUP_S3_BUCKET=s3://minisoc-backups
BACKUP_RETENTION_DAYS=30

# ========================
# SSL/TLS
# ========================
SSL_CERT_PATH=./infrastructure/nginx/ssl/fullchain.pem
SSL_KEY_PATH=./infrastructure/nginx/ssl/privkey.pem
