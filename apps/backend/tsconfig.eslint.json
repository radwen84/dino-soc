{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "types": [
      "node",
      "jest"
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "*.ts",
    "src/@types/**/*.d.ts",
    "prisma/**/*.ts",
    "prisma/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}