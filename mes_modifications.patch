+    steps:
+      - uses: actions/checkout@v4
+      - name: Validate Suricata rules syntax
+        run: |
+          RULES_FILE="security/suricata/rules/custom-minisoc.rules"
+          RULE_COUNT=$(grep -c "^alert " "$RULES_FILE")
+          echo "Suricata rules: $RULE_COUNT rules found"
+          test "$RULE_COUNT" -gt 0
+
+          # Check all rules have sid
+          MISSING_SID=$(grep "^alert " "$RULES_FILE" | grep -cv "sid:")
+          if [ "$MISSING_SID" -gt 0 ]; then
+            echo "ERROR: $MISSING_SID rules missing sid" >&2
+            exit 1
+          fi
+          echo "All Suricata rules have valid sids"
+
+      - name: Validate Wazuh rules XML
+        run: |
+          python3 -c "
+          import xml.etree.ElementTree as ET
+          tree = ET.parse('security/wazuh/rules/local_rules.xml')
+          root = tree.getroot()
+          rules = root.findall('.//rule')
+          print(f'Wazuh rules valid: {len(rules)} rules parsed')
+          assert len(rules) > 0, 'No rules found'
+          for r in rules:
+              assert r.get('id'), f'Rule missing id'
+              assert r.get('level'), f'Rule {r.get(\"id\")} missing level'
+          "
+
+      - name: Validate Sigma rules
