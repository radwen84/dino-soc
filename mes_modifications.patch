+          assert d['risk_score'] <= 100, 'Risk score must be <= 100'
+          assert d['risk_level'] in ('low','medium','high','critical'), f'Bad risk_level: {d[\"risk_level\"]}'
+          "
+
+          # /ueba/score
+          UEBA=$(curl -sf -X POST http://localhost:8000/ueba/score \
+            -H 'Content-Type: application/json' \
