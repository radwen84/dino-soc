+                  content = f.read()
+              for doc in content.split('---'):
+                  doc = doc.strip()
+                  if not doc: continue
+                  data = yaml.safe_load(doc)
+                  if not isinstance(data, dict): continue
+                  title = data.get('title', 'untitled')
+                  tags = data.get('tags', [])
+                  mitre_tags = [t for t in tags if t.startswith('attack.t')]
+                  print(f'  {title}: {len(mitre_tags)} MITRE tags')
+                  count += 1
+          assert count > 0, 'No Sigma rules found'
+          print(f'Sigma rules valid: {count} rules')
+          "
+
