+
+          # Wait for startup with retry loop
+          for i in $(seq 1 15); do
+            if curl -sf http://localhost:8000/health > /dev/null 2>&1; then
+              echo "ML Engine ready after ${i}s"
+              break
+            fi
+            sleep 1
+          done
